# Studio 954 Booking — environment
#
# Copy this file to .env.local and fill it in. .env.local is git-ignored and
# must never be committed.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI.
# Use the connection *pooler* string (port 6543) and replace [YOUR-PASSWORD]
# with the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ---------------------------------------------------------------------------
# File storage (required for photo and script uploads)
# ---------------------------------------------------------------------------
# Set and option photography, plus client teleprompter scripts, are stored in
# Supabase Storage. Until both values are present the upload buttons explain
# that storage is unconfigured and a photo URL can still be pasted by hand.
#
# Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Supabase -> Project Settings -> API Keys -> service_role (secret).
# SERVER ONLY. This key bypasses every row-level policy — never expose it to
# the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Email (optional — messages are logged, not sent, until both are set)
# ---------------------------------------------------------------------------
# Transactional email via Resend. The provider sits behind a small interface,
# so swapping it out means writing one class in src/server/email/mailer.ts.
RESEND_API_KEY=""
# Must be a verified sender on your Resend domain.
EMAIL_FROM="Studio 954 <booking@studio954.com>"

# ---------------------------------------------------------------------------
# Google Calendar (optional — sync is skipped entirely until configured)
# ---------------------------------------------------------------------------
# The calendar bookings are mirrored to. Usually ends in
# @group.calendar.google.com.
GOOGLE_CALENDAR_ID=""

# Option A — service account (recommended).
# Create one in Google Cloud, download its JSON key, then share the Studio 954
# calendar with this email and grant "Make changes to events".
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Keep the literal \n escapes from the JSON key; they are converted at runtime.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Option B — OAuth, for syncing into a personal Google account instead.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""

# ---------------------------------------------------------------------------
# Scheduled reminders (optional)
# ---------------------------------------------------------------------------
# Shared secret for GET /api/cron/reminders. Point a scheduler at that endpoint
# every 15–30 minutes with an "Authorization: Bearer <secret>" header.
CRON_SECRET=""
